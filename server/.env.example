# Server Port
PORT=5000

# MongoDB URI (leave empty or omit to automatically use embedded MongoMemoryServer for zero-config local development)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/servicevisit-tracker?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=servicevisit-tracker-super-secret-key-2026-production

# Node Environment
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

